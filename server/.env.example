# ⚠️ EXEMPLO DE CONFIGURAÇÃO - NÃO COMMITAR COM CREDENCIAIS REAIS

# Environment Variables
NODE_ENV=development
PORT=5000

# Database - MongoDB Local
MONGODB_URI=mongodb://localhost:27017/calendario-social
MONGODB_DB_NAME=calendario-social

# JWT Secret
JWT_SECRET=calendariojwtsecretkey2025supersegurojwtkey

# Cloudinary para Upload de Imagens
CLOUDINARY_CLOUD_NAME=seu_cloudinary_cloud_name
CLOUDINARY_API_KEY=seu_cloudinary_api_key
CLOUDINARY_API_SECRET=seu_cloudinary_api_secret

# ⚠️ INSTAGRAM OAUTH - SUBSTITUA PELOS VALORES REAIS
# Obtenha em: https://developers.facebook.com/
INSTAGRAM_CLIENT_ID=seu_instagram_app_id_real_aqui
INSTAGRAM_CLIENT_SECRET=seu_instagram_app_secret_real_aqui
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram-auth/callback

# Instagram API (legacy - ainda usado para publicação)
INSTAGRAM_ACCESS_TOKEN=seu_access_token_real_aqui
INSTAGRAM_BUSINESS_ACCOUNT_ID=seu_business_account_id_real_aqui

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# 📋 COMO CONFIGURAR O INSTAGRAM:
# ====================================
# 
# 1. Acesse: https://developers.facebook.com/
# 2. Crie um novo app
# 3. Adicione "Instagram Basic Display"
# 4. Configure URLs de redirecionamento:
#    - http://localhost:5000/api/instagram-auth/callback
# 5. Copie Client ID e Client Secret
# 6. Substitua os valores acima
# 7. Reinicie o servidor
#
# Guia detalhado: INSTAGRAM-CONFIG-DETALHADO.md
